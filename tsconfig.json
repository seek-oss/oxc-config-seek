{
  "extends": "tsconfig-seek",
  "compilerOptions": {
    "noEmit": true,
    "incremental": true,
    "allowImportingTsExtensions": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2023",
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": [
    "src",
    "fixtures",
    "oxlint.config.ts",
    "oxfmt.config.ts",
    "tsdown.config.ts"
  ],
  "exclude": ["fixtures/corpus", "fixtures/format", "fixtures/smoke"]
}

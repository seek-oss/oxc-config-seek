{
  "name": "oxc-config-seek",
  "version": "1.0.0",
  "description": "Shareable oxlint and oxfmt config for SEEK",
  "homepage": "https://github.com/seek-oss/oxc-config-seek#readme",
  "bugs": {
    "url": "https://github.com/seek-oss/oxc-config-seek/issues"
  },
  "license": "MIT",
  "author": "SEEK",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seek-oss/oxc-config-seek.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./base": "./dist/base.mjs",
    "./extensions": "./dist/extensions.mjs",
    "./oxfmt": "./dist/oxfmt/index.mjs",
    "./plugins/react": "./dist/plugins/react.mjs",
    "./plugins/typescript": "./dist/plugins/typescript.mjs",
    "./vitest": "./dist/vitest/index.mjs",
    "./vitest/base": "./dist/vitest/base.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "format": "pnpm build && oxlint --fix && oxfmt",
    "lint": "pnpm build && oxlint && oxfmt --check",
    "release": "changeset publish",
    "test": "pnpm build && pnpm run \"/^test:/\"",
    "test:base": "oxlint --config src/base.ts fixtures",
    "test:react": "oxlint --config src/index.ts fixtures",
    "test:vitest": "oxlint --config src/vitest/index.ts fixtures",
    "test:vitest-base": "oxlint --config src/vitest/base.ts fixtures",
    "version": "changeset version && oxfmt"
  },
  "dependencies": {
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "eslint-plugin-cypress": "^6.4.4",
    "eslint-plugin-react": "^7.37.5",
    "oxlint-plugin-eslint": "^1.80.0",
    "oxlint-plugin-import-zod": "^1.0.1"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "0.18.5",
    "@changesets/cli": "3.0.1",
    "@skuba-lib/changesets-changelog": "1.0.1",
    "@types/node": "26.3.0",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "oxlint-tsgolint": "7.0.2001",
    "publint": "0.3.24",
    "tsconfig-seek": "2.0.0",
    "tsdown": "0.22.14",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "oxfmt": ">=0.65.0",
    "oxlint": ">=1.80.0",
    "oxlint-tsgolint": ">=7.0.2001",
    "typescript": ">=5.5.4"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.24.0"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
